# ═══════════════════════════════════════════════════════════════════════════
# DEVELOPMENT environment — copy to `.env.development.local` and fill in.
# Point this at your DEV Supabase project (keep it separate from production).
# Used by `pnpm dev` and the db scripts (pnpm db:create / db:seed / db:reset…).
# This file (.example) is committed; .env.development.local is gitignored.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase (dev project) ──────────────────────────────────────────────────
# Settings → API Keys.  The PUBLISHABLE key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-DEV-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# SECRET key — server only. Bypasses RLS. Never expose this.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# ── Stripe (test keys for dev) ──────────────────────────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxx
# Two endpoints, because there are two Stripe accounts. Ours carries the
# subscriptions; each restaurant's carries the food a diner pays for, which is
# a direct charge. Stripe issues a separate signing secret per endpoint, and
# using the wrong one fails every event with a 400 that looks like a delivery
# problem. Register both at the same path:
#   .../api/webhooks/stripe          → "events on your account"
#   .../api/webhooks/stripe/connect  → "events on connected accounts"
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_WEBHOOK_SECRET_CONNECT=whsec_xxxxxxxx

# ── Database (direct Postgres, for the db scripts) ──────────────────────────
# Supabase → Connect → "Session pooler" URI, with your DB password.
DATABASE_URL=postgresql://postgres.YOUR-DEV-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Platform admin (re-linked on every db:seed / db:reset)
PLATFORM_ADMIN_EMAIL=admin@tabletap.dev
PLATFORM_ADMIN_PASSWORD=change-me
